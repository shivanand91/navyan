{
  "schemaVersion": "2.0.0",
  "name": "Navyan Resume Internship Matching Rules",
  "description": "Deterministic preset rules for matching extracted resume text to existing published internship records in MongoDB.",
  "engine": {
    "type": "rule_based",
    "externalAiApiRequired": false,
    "databaseOfTruth": "MongoDB",
    "internshipDetailsStoredHere": false,
    "alwaysRecommendWhenPublishedOptionsExist": true,
    "minimumRecommendations": 3,
    "maximumRecommendations": 6,
    "onlyReturnInternshipsFoundInDatabase": true,
    "onlyReturnPublishedInternships": true,
    "neverInventResumeEvidence": true,
    "neverClaimMachineLearning": true
  },
  "databaseMapping": {
    "purpose": "Connect a matching preset to an existing MongoDB internship document. Adapt the lookup field to the existing schema.",
    "preferredLookupField": "slug",
    "publishedStatusExpectedValue": "Published",
    "presetToDatabase": [
      {
        "presetId": "CYBER_AI",
        "slug": "cyber-ai-internship"
      },
      {
        "presetId": "AGENTIC_X",
        "slug": "agentic-x-internship"
      },
      {
        "presetId": "DATA_ANALYTICS",
        "slug": "data-analytics"
      },
      {
        "presetId": "FULLSTACK_DEVELOPMENT",
        "slug": "fullstack-development"
      },
      {
        "presetId": "BACKEND_DEVELOPMENT",
        "slug": "backend-development"
      },
      {
        "presetId": "MOBILE_APP_DEVELOPMENT",
        "slug": "mobile-app-development"
      },
      {
        "presetId": "ANDROID_DEVELOPMENT",
        "slug": "android-development"
      },
      {
        "presetId": "WEB_DEVELOPMENT",
        "slug": "web-development"
      },
      {
        "presetId": "FRONTEND_DEVELOPMENT",
        "slug": "frontend-development"
      },
      {
        "presetId": "UI_UX_DESIGN",
        "slug": "ui-ux-design"
      }
    ],
    "important": "Do not use this mapping to build the displayed internship card. Fetch the actual published MongoDB document and use its current title, pricing, duration, image, description, mode and application URL."
  },
  "resumeParsing": {
    "supportedFormats": [
      "pdf",
      "docx"
    ],
    "extractSections": [
      "name",
      "summary",
      "skills",
      "projects",
      "experience",
      "internships",
      "education",
      "certifications",
      "coursework"
    ],
    "nameExtraction": {
      "enabled": true,
      "requireConfidence": true,
      "fallbackGreeting": "there",
      "neverGuessName": true
    },
    "normalization": {
      "lowercaseForMatching": true,
      "collapseWhitespace": true,
      "removePunctuationForMatching": true,
      "useTokenAwareMatching": true,
      "preserveSectionEvidence": true,
      "deduplicateDetectedSkills": true
    },
    "aliases": {
      "javascript": [
        "js",
        "ecmascript"
      ],
      "typescript": [
        "ts"
      ],
      "react": [
        "react.js",
        "reactjs"
      ],
      "node.js": [
        "node",
        "nodejs"
      ],
      "express.js": [
        "express",
        "expressjs"
      ],
      "mongodb": [
        "mongo",
        "mongo db"
      ],
      "postgresql": [
        "postgres",
        "postgres db"
      ],
      "machine learning": [
        "ml"
      ],
      "artificial intelligence": [
        "ai"
      ],
      "generative ai": [
        "genai",
        "gen ai"
      ],
      "large language models": [
        "llm",
        "llms"
      ],
      "retrieval augmented generation": [
        "rag"
      ],
      "natural language processing": [
        "nlp"
      ],
      "cybersecurity": [
        "cyber security",
        "information security",
        "infosec"
      ],
      "data analytics": [
        "data analysis",
        "analytics"
      ],
      "ui/ux": [
        "user interface",
        "user experience"
      ],
      "android development": [
        "android app development"
      ],
      "mobile app development": [
        "mobile development"
      ],
      "rest api": [
        "restful api",
        "REST APIs"
      ],
      "power bi": [
        "powerbi"
      ],
      "figma": [
        "figma design"
      ]
    }
  },
  "scoring": {
    "weights": {
      "requiredSkills": 0.35,
      "preferredSkills": 0.15,
      "projectEvidence": 0.2,
      "experienceEvidence": 0.1,
      "domainKeywords": 0.1,
      "learningFit": 0.1
    },
    "labels": [
      {
        "minScore": 75,
        "maxScore": 100,
        "label": "Strong match"
      },
      {
        "minScore": 50,
        "maxScore": 74,
        "label": "Good learning match"
      },
      {
        "minScore": 25,
        "maxScore": 49,
        "label": "Potential match"
      },
      {
        "minScore": 0,
        "maxScore": 24,
        "label": "Recommended starting point"
      }
    ],
    "rankingRules": [
      "Calculate each category score from distinct matched evidence; do not reward repeated mentions of the same skill multiple times.",
      "Normalize category scores to a 0-1 range before applying weights.",
      "Use fallbackPriority only as a tie-breaker or a small configurable learning-fit factor; it must not override strong resume evidence.",
      "Cap final matchScore at 100.",
      "Do not award strong-match labels without sufficient positive evidence."
    ]
  },
  "fallbackPolicy": {
    "noProjectsButSkillsMatch": {
      "recommend": true,
      "messageTemplate": "{studentGreeting}, your resume includes skills related to {internshipTitle}, but we could not confidently identify a directly related project. This internship may help you practise these skills and build portfolio evidence.",
      "showPortfolioProjectSuggestions": true
    },
    "noExperience": {
      "recommendBeginnerFriendlyOptions": true,
      "doNotExcludeOnlyForLackOfExperience": true
    },
    "noExactDomainMatch": {
      "recommendBestAvailablePublishedOptions": true,
      "rankBy": [
        "matchedSkills",
        "relatedKeywords",
        "projectEvidence",
        "learningFit",
        "fallbackPriority"
      ],
      "useTransparentLowMatchLabel": true
    },
    "noRecognizedSkills": {
      "recommendBeginnerOptionsIfAvailable": true,
      "explainLowConfidence": true,
      "neverFabricateMatches": true
    },
    "noPublishedDatabaseRecords": {
      "returnEmptyRecommendations": true,
      "message": "We could not find a currently published internship matching this analysis. Please check again later."
    },
    "presetWithoutDatabaseRecord": {
      "skipRecord": true,
      "continueToNextRankedCandidate": true
    }
  },
