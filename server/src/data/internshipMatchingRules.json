  "personalizedMessages": {
    "welcomeWithName": "Hi {studentName}, we've reviewed the skills and experience identified in your resume.",
    "welcomeWithoutName": "Hi there, we've reviewed the skills and experience identified in your resume.",
    "strongMatch": "{studentGreeting}, your resume contains relevant evidence for {internshipTitle}. Matching areas include {matchedSkills}. This internship may help you deepen those skills.",
